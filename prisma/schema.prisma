generator client {
 provider = "prisma-client-js"
 engineType = "client"
}
datasource db {
 provider = "postgresql"
}
model Session {
 id String @id @default(cuid())
 tokenHash String @unique
 createdAt DateTime @default(now())
 expiresAt DateTime
 inbox TemporaryInbox?
 @@index([expiresAt])
}
model TemporaryInbox {
 id String @id @default(cuid())
 emailAddress String @unique
 sessionId String @unique
 session Session @relation(fields:[sessionId], references:[id], onDelete:Cascade)
 createdAt DateTime @default(now())
 expiresAt DateTime
 status String @default("active")
 messages EmailMessage[]
 @@index([expiresAt, status])
}
model EmailMessage {
 id String @id @default(cuid())
 inboxId String
 inbox TemporaryInbox @relation(fields:[inboxId], references:[id], onDelete:Cascade)
 providerMessageId String
 sender String
 recipient String
 subject String
 textBody String
 sanitizedHtmlBody String
 receivedAt DateTime @default(now())
 isRead Boolean @default(false)
 attachments EmailAttachment[]
 @@unique([inboxId, providerMessageId])
 @@index([inboxId, receivedAt])
}
model EmailAttachment {
 id String @id @default(cuid())
 messageId String
 message EmailMessage @relation(fields:[messageId], references:[id], onDelete:Cascade)
 filename String
 contentType String
 fileSize Int
 storageKey String @unique @default(cuid())
 data Bytes
 scanStatus String @default("clean")
}
model Setting {
 key String @id
 value Int
}
